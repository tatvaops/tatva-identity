# Product
NEXT_PUBLIC_PRODUCT_NAME=Tatva Identity
NEXT_PUBLIC_PRODUCT_TAGLINE=Verified professional identity for every kind of work
NEXT_PUBLIC_ECOSYSTEM_NAME=Tatva

# Supabase — used by the Next.js app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — local/server only. Never expose as NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=

# WhatsApp OTP via Tatva Vision
TATVA_USERS_API_BASE_URL=https://devopsapi.withtatva.ai
TATVA_VISION_OTP_ENABLED=true
# REDIS_URL=
# OTP_HMAC_SECRET=
# Local WhatsApp OTP without Vision:
# TATVA_VISION_OTP_ENABLED=false

# Platform operations console at /admin.
# Comma-separated handles (without @) and/or profile UUIDs. Visiting /admin upserts a matching signed-in user into platform_admins.
# PLATFORM_ADMIN_HANDLES=yourhandle
# PLATFORM_ADMIN_USER_IDS=
