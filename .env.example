# Product
NEXT_PUBLIC_PRODUCT_NAME=Tatva Identity
NEXT_PUBLIC_PRODUCT_TAGLINE=Verified professional identity for every kind of work
NEXT_PUBLIC_ECOSYSTEM_NAME=Tatva

# Supabase — used by the Next.js app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — local/server only. Never expose as NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=

# WhatsApp OTP via Tatva Vision
TATVA_USERS_API_BASE_URL=https://devopsapi.withtatva.ai
TATVA_VISION_OTP_ENABLED=true
# REDIS_URL=
# OTP_HMAC_SECRET=
# Local WhatsApp OTP without Vision:
# TATVA_VISION_OTP_ENABLED=false

# Platform operations console at /admin.
# Comma-separated handles (without @) and/or profile UUIDs. Visiting /admin upserts a matching signed-in user into platform_admins.
# PLATFORM_ADMIN_HANDLES=yourhandle
# PLATFORM_ADMIN_USER_IDS=

# ── Vantage Forums (IDENTITI consumer) ────────────────────────
# Browser redirects. No trailing slash.
NEXT_PUBLIC_VANTAGE_FORUMS_ORIGIN=https://vantage.withtatva.ai
# This app's public origin. Used as JWT return_url and webhook host.
NEXT_PUBLIC_APP_ORIGIN=https://tatva-identity-dev.vercel.app
# Extra return_url origins, comma-separated. localhost and tatva-identity-dev are always allowed.
VANTAGE_ALLOWED_RETURN_ORIGINS=https://tatva-identity-dev.vercel.app

# HMAC-SHA256 secret. IDENTITI signs context JWTs with this. Never NEXT_PUBLIC_.
# Generate: openssl rand -base64 48
# Give the same value to Vantage as VANTAGE_FORUM_PUBLIC_KEY.
IDENTITI_FORUM_PRIVATE_KEY=
# Placeholder only on IDENTITI. The live copy lives on Vantage.
VANTAGE_FORUM_PUBLIC_KEY=

# Bearer token Vantage sends to POST /api/forum/webhooks/discussion-created
# Generate: openssl rand -hex 32
VANTAGE_FORUM_WRITE_TOKEN=

# Planned Vantage server API. Leave empty until those endpoints exist.
VANTAGE_API_BASE_URL=
VANTAGE_FORUM_READ_TOKEN=
